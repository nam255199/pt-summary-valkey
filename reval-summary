table.kv td{padding:4px 0;word-break:break-word}
table.kv tr+tr th,table.kv tr+tr td{border-top:1px dashed var(--border)}
td.crit,table.kv td.crit{color:var(--crit);background:var(--crit-bg);font-weight:600}
td.warn,table.kv td.warn{color:var(--warn);background:var(--warn-bg);font-weight:600}
td.ok{color:var(--ok)}
.sev{display:inline-block;min-width:44px;text-align:center;padding:1px 8px;border-radius:999px;font-size:11px;font-weight:700}
.sev.CRIT{background:var(--crit-bg);color:var(--crit)}.sev.WARN{background:var(--warn-bg);color:var(--warn)}.sev.INFO{background:var(--info-bg);color:var(--info)}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
.toolbar button{border:1px solid var(--border);background:var(--panel);color:var(--text);padding:5px 12px;border-radius:999px;cursor:pointer;font-size:13px}
.toolbar button.on{background:var(--accent);border-color:var(--accent);color:#fff}
input.filter,select.nodesel{border:1px solid var(--border);background:var(--panel);color:var(--text);padding:6px 10px;border-radius:8px;font-size:13px;min-width:240px}
.finding td.reco{color:var(--text)}
.finding td.det{color:var(--muted)}
.fnd td:nth-child(1),.fnd td:nth-child(2){white-space:nowrap}.fnd td:nth-child(3){min-width:160px}.fnd td:nth-child(4){max-width:220px}
details{margin:8px 0}
details summary{cursor:pointer;color:var(--accent)}
pre{background:var(--code);border:1px solid var(--border);border-radius:8px;padding:10px 12px;overflow:auto;font:12px/1.45 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;max-height:520px}
.node{display:none}.node.show{display:block}
.node h3 .role{font-size:12px;font-weight:600;color:var(--muted);margin-left:8px}
.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px}
footer{color:var(--muted);font-size:12px;text-align:center;padding:20px}
@media print{header.top{position:static}.node{display:block!important}details{display:block}}
</style>
EOF
}

html_js() {
  cat <<'EOF'
<script>
(function(){
  function val(t){t=t.replace(/,/g,'').trim();var m=t.match(/^(-?\d+(?:\.\d+)?)\s*([KMGTP]?)B?\s*(%|ms|s)?$/);if(!m)return null;
    var mul={'':1,K:1024,M:1048576,G:1073741824,T:1099511627776,P:1125899906842624}[m[2]];return parseFloat(m[1])*mul;}
  document.querySelectorAll('table.sortable thead th').forEach(function(th){
    th.addEventListener('click',function(){
      var table=th.closest('table'),tb=table.tBodies[0],idx=Array.prototype.indexOf.call(th.parentNode.children,th);
      var asc=th.getAttribute('data-dir')!=='asc';
      table.querySelectorAll('thead th').forEach(function(h){h.removeAttribute('data-dir');});
      th.setAttribute('data-dir',asc?'asc':'desc');
      var rows=Array.prototype.slice.call(tb.rows);
      rows.sort(function(a,b){var x=a.cells[idx]?a.cells[idx].textContent:'',y=b.cells[idx]?b.cells[idx].textContent:'';
        var nx=val(x),ny=val(y),r=(nx!==null&&ny!==null)?nx-ny:x.localeCompare(y);return asc?r:-r;});
      rows.forEach(function(r){tb.appendChild(r);});
    });
  });
  var sevBtns=document.querySelectorAll('#sevfilter button'),fsearch=document.getElementById('fsearch');
  function applyFindings(){
    var on=document.querySelector('#sevfilter button.on'),sev=on?on.getAttribute('data-sev'):'ALL',q=(fsearch&&fsearch.value||'').toLowerCase();
    document.querySelectorAll('tr.finding').forEach(function(tr){
      var ok=(sev==='ALL'||tr.getAttribute('data-sev')===sev)&&(!q||tr.textContent.toLowerCase().indexOf(q)>=0);
      tr.style.display=ok?'':'none';});
  }
  sevBtns.forEach(function(b){b.addEventListener('click',function(){sevBtns.forEach(function(x){x.classList.remove('on');});b.classList.add('on');applyFindings();});});
  if(fsearch)fsearch.addEventListener('input',applyFindings);
  document.querySelectorAll('input.filter[data-table]').forEach(function(inp){
    inp.addEventListener('input',function(){var t=document.getElementById(inp.getAttribute('data-table')),q=inp.value.toLowerCase();
      if(!t)return;Array.prototype.forEach.call(t.tBodies[0].rows,function(r){r.style.display=r.textContent.toLowerCase().indexOf(q)>=0?'':'none';});});
  });
  var sel=document.getElementById('nodesel');
  function showNode(){var v=sel.value;document.querySelectorAll('.node').forEach(function(n){n.classList.toggle('show',v==='__all'||n.id===v);});}
  if(sel){sel.addEventListener('change',showNode);showNode();}
  document.querySelectorAll('a[data-node]').forEach(function(a){a.addEventListener('click',function(){if(sel){sel.value=a.getAttribute('data-node');showNode();}});});
})();
</script>
EOF
}

write_html() {
  local lab r i=0 nid
  {
    printf '<!doctype html>\n<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">\n'
    printf '<title>Valkey Health Report - %s</title>\n' "$(he "${M[seed]:-}")"
    html_css
    printf '</head><body>\n'
    printf '<header class="top"><div class="brand">%s</div><nav>' "$TOOL"
    printf '<a href="#summary">Summary</a><a href="#findings">Findings</a><a href="#topology">Topology</a><a href="#nodes">Nodes</a><a href="#config">Configuration</a><a href="#details">Node details</a>'
    [[ -s $OUTDIR/os/os.txt ]] && printf '<a href="#os">OS</a>'
    printf '</nav></header>\n<main>\n'

    # Summary
    printf '<section id="summary"><h1>Valkey / Redis health report</h1>\n<div class="meta">'
    printf '<span>Seed <b>%s</b></span><span>Mode <b>%s</b></span><span>Collected <b>%s</b></span><span>From <b>%s</b></span><span>Product <b>%s</b></span><span>Tool <b>%s %s</b></span>' \
      "$(he "${M[seed]:-?}")" "$MODE" "$(he "${M[collected_at]:-?}")" "$(he "${M[collector_host]:-?}")" "$(he "$PRODUCT_SUMMARY")" "$TOOL" "$(he "${M[tool_version]:-$VERSION}")"
    printf '</div>\n<div class="cards">'
    printf '<div class="stat score"><div class="l">Health score</div><div class="v g-%s">%s</div><div class="muted">%s</div></div>' "$GRADE" "$SCORE" "$GRADE"
    printf '<div class="stat crit"><div class="l">Critical</div><div class="v">%s</div></div>' "$N_CRIT"
    printf '<div class="stat warn"><div class="l">Warning</div><div class="v">%s</div></div>' "$N_WARN"
    printf '<div class="stat info"><div class="l">Info</div><div class="v">%s</div></div>' "$N_INFO"
    printf '<div class="stat"><div class="l">Nodes</div><div class="v">%s</div><div class="muted">%s primaries%s</div></div>' "${#NODES[@]}" "$N_PRIM" \
      "$( (( ${#UNREACHABLE[@]} )) && printf ', %s unreachable' "${#UNREACHABLE[@]}")"
    printf '<div class="stat"><div class="l">Data on primaries</div><div class="v">%s</div><div class="muted">%s keys</div></div>' "$(hb "$TOT_USED")" "$(commas "$TOT_KEYS")"
    printf '<div class="stat"><div class="l">Ops/sec</div><div class="v">%s</div><div class="muted">all nodes, at collection</div></div>' "$(commas "$TOT_OPS")"
    (( IS_CLUSTER )) && printf '<div class="stat"><div class="l">Cluster state</div><div class="v %s">%s</div><div class="muted">%s shards, %s known nodes</div></div>' \
      "$( [[ $CLUSTER_STATE == ok ]] && echo g-Good || echo g-Critical)" "$(he "$CLUSTER_STATE")" "$(he "$CLUSTER_SIZE")" "$(he "$CLUSTER_KNOWN")"
    printf '</div></section>\n'

    # Findings
    printf '<section id="findings"><h2>Findings and recommendations</h2>\n'
    printf '<div class="toolbar" id="sevfilter"><button class="on" data-sev="ALL">All (%s)</button><button data-sev="CRIT">Critical (%s)</button><button data-sev="WARN">Warning (%s)</button><button data-sev="INFO">Info (%s)</button>' \
      $(( N_CRIT + N_WARN + N_INFO )) "$N_CRIT" "$N_WARN" "$N_INFO"
    printf '<input class="filter" id="fsearch" placeholder="Search findings..."></div>\n'
    if [[ -s $RPT/findings.tsv ]]; then
      printf '<div class="tw"><table class="data fnd"><thead><tr><th>Severity</th><th>Area</th><th>Finding</th><th>Nodes</th><th>Details</th><th>Recommendation</th></tr></thead><tbody>\n'
      local sev area title nodes cnt d1 dall reco
      while IFS=$'\t' read -r sev area title nodes cnt d1 dall reco; do
        [[ $nodes == - ]] && nodes=""
        printf '<tr class="finding" data-sev="%s"><td><span class="sev %s">%s</span></td><td>%s</td><td><b>%s</b></td><td>%s</td><td class="det">' \
          "$sev" "$sev" "$sev" "$(he "$area")" "$(he "$title")" "$(he "${nodes:-cluster}")"
        if (( cnt > 1 )); then
          printf '%s<details><summary>all %s nodes</summary>' "$(he "$d1")" "$cnt"
          tr '\037' '\n' <<< "$dall" | while IFS= read -r x; do printf '%s<br>' "$(he "$x")"; done
          printf '</details>'
        else
          printf '%s' "$(he "$d1")"
        fi
        printf '</td><td class="reco">%s</td></tr>\n' "$(he "$reco")"
      done < "$RPT/findings.tsv"
      printf '</tbody></table></div>\n'
    else
      printf '<p>No findings.</p>\n'
    fi
    printf '</section>\n'

    # Topology
    printf '<section id="topology"><h2>Topology</h2>\n'
    if (( IS_CLUSTER )); then printf '<p class="muted">Cluster view from %s (CLUSTER NODES). Shards are ordered by their first slot.</p>\n' "$(he "$SEED_LAB")"
    else printf '<p class="muted">Primaries and their replicas (INFO replication).</p>\n'; fi
    html_table "$RPT/topology.tsv"
    printf '</section>\n'

    # Overview
    printf '<section id="nodes"><h2>Nodes</h2>\n'
    html_table "$RPT/overview.tsv"
    printf '</section>\n'

    # Configuration
    printf '<section id="config"><h2>Configuration</h2><div class="two"><div><h3>Key parameters</h3>\n'
    html_table "$RPT/keycfg.tsv"
    printf '<p class="muted">When nodes differ, each value is followed by [number of nodes].</p></div>\n'
    if [[ -s $RPT/config_diff.tsv ]]; then
      printf '<div><h3>Differences between nodes</h3>\n'
      html_table "$RPT/config_diff.tsv"
      printf '<p class="muted">Node-specific parameters (ports, files, announce addresses) are excluded.</p></div>\n'
    fi
    printf '</div></section>\n'

    # Node details
    printf '<section id="details"><h2>Node details</h2>\n<div class="toolbar"><select id="nodesel" class="nodesel">'
    i=0
    for lab in "${NODES[@]}"; do
      ((i++)); printf '<option value="n%s">%s (%s)</option>' "$i" "$(he "$lab")" "${N_ROLE[$lab]/slave/replica}"
    done
    printf '<option value="__all">Show all nodes</option></select></div>\n'
    i=0
    for lab in "${NODES[@]}"; do
      ((i++)); nid="n$i"; r="$RPT/nodes/${N_DIR[$lab]}"; local d="$OUTDIR/nodes/${N_DIR[$lab]}"
      printf '<div class="node" id="%s"><h3>%s<span class="role">%s · %s %s</span></h3>\n' "$nid" "$(he "$lab")" "${N_ROLE[$lab]/slave/replica}" "${N_PRODUCT[$lab]}" "$(he "${N_VER[$lab]}")"
      printf '<div class="grid">'
      html_kv "$r/server.kv" "Server"
      html_kv "$r/memory.kv" "Memory"
      html_kv "$r/persistence.kv" "Persistence"
      html_kv "$r/replication.kv" "Replication"
      html_kv "$r/cluster.kv" "Cluster"
      html_kv "$r/clients.kv" "Clients"
      html_kv "$r/stats.kv" "Stats"
      printf '</div>\n'
      if (( $(wc -l < "$r/replicas.tsv") > 1 )); then printf '<h3>Replicas</h3>'; html_table "$r/replicas.tsv"; fi
      printf '<h3>Keyspace</h3>'; html_table "$r/keyspace.tsv"
      printf '<h3>Top commands by total time</h3>'; html_table "$r/cmdstats.tsv"
      printf '<div class="two"><div><h3>Error replies</h3>'; html_table "$r/errorstats.tsv"; printf '</div>'
      printf '<div><h3>Latency events</h3>'; html_table "$r/latency.tsv"; printf '</div></div>\n'
      printf '<div class="two"><div><h3>Slow log by command</h3>'; html_table "$r/slowlog_summary.tsv"; printf '</div>'
      printf '<div><h3>Memory stats</h3>'; html_table "$r/memory_stats.tsv"; printf '</div></div>\n'
      printf '<h3>Slow log (slowest 50)</h3>'; html_table "$r/slowlog.tsv"
      if [[ -s $r/client_ips.tsv ]]; then
        printf '<h3>Clients</h3><div class="two"><div>'; html_table "$r/client_ips.tsv"; printf '</div><div>'; html_table "$r/client_names.tsv"
        printf '</div><div>'; html_table "$r/client_cmds.tsv"; printf '</div><div>'; html_table "$r/client_users.tsv"; printf '</div></div>\n'
      fi
      printf '<h3>Diagnostics</h3>'
      html_pre "$d/latency_doctor.txt" "LATENCY DOCTOR"
      html_pre "$d/memory_doctor.txt" "MEMORY DOCTOR"
      html_pre "$d/bigkeys.txt" "--bigkeys"
      html_pre "$d/memkeys.txt" "--memkeys"
      html_pre "$d/commandlog_large_request.txt" "COMMANDLOG large-request"
      html_pre "$d/commandlog_large_reply.txt" "COMMANDLOG large-reply"
      html_pre "$d/module_list.txt" "MODULE LIST"
      html_pre "$d/acl.txt" "ACL LIST (secrets redacted)"
      html_pre "$d/cluster_nodes.txt" "CLUSTER NODES"
      local e
      for e in "$d"/*.err; do [[ -e $e ]] && html_pre "$e" "Error: $(basename "$e" .err)"; done
      if [[ -s $d/config.txt ]]; then
        printf '<details><summary>Full configuration (%s parameters)</summary><input class="filter" data-table="cfg%s" placeholder="Filter parameters...">' "$(wc -l < "$d/config.txt")" "$i"
        { printf 'Parameter\tValue\n'; sort "$d/config.txt"; } > "$r/config_full.tsv"
        html_table "$r/config_full.tsv" "cfg$i"
        printf '</details>\n'
      fi
      html_pre "$d/info.txt" "Raw INFO"
      printf '</div>\n'
    done
    printf '</section>\n'

    # OS
    if [[ -s $OUTDIR/os/os.txt ]]; then
      printf '<section id="os"><h2>Operating system (%s)</h2><div class="grid">' "$(he "${OSV[hostname]:-local}")"
      {
        kvp "OS" "${OSV[os]:-?}"
        kvp "Kernel" "${OSV[kernel]:-?} (${OSV[arch]:-?})"
        kvp "CPUs" "${OSV[cpus]:-?} x ${OSV[cpu_model]:-?}"
        kvp "NUMA nodes" "${OSV[numa_nodes]:-?}"
        kvp "Memory" "$(hb $(( ${OSV[memtotal]:-0} * 1024 ))) total, $(hb $(( ${OSV[memavailable]:-0} * 1024 ))) available"
        kvp "Swap" "$(hb $(( ${OSV[swaptotal]:-0} * 1024 ))) total, $(hb $(( (${OSV[swaptotal]:-0} - ${OSV[swapfree]:-0}) * 1024 ))) used"
        local t=${OSV[thp_enabled]:-?}; [[ $t == *"[always]"* ]] && t="!w!$t"
        kvp "THP enabled" "$t"
        kvp "THP defrag" "${OSV[thp_defrag]:-?}"
        t=${OSV[vm.overcommit_memory]:-?}; [[ $t != 1 ]] && t="!w!$t"
        kvp "vm.overcommit_memory" "$t"
        kvp "vm.swappiness" "${OSV[vm.swappiness]:-?}"
        kvp "net.core.somaxconn" "${OSV[net.core.somaxconn]:-?}"
        kvp "tcp_max_syn_backlog" "${OSV[net.ipv4.tcp_max_syn_backlog]:-?}"
        kvp "Load average" "${OSV[loadavg]:-?}"
        kvp "Uptime" "$(hdur "${OSV[uptime_sec]:-0}")"
        kvp "Container" "${OSV[container]:-?}${OSV[cgroup_memory_limit]:+ (memory limit ${OSV[cgroup_memory_limit]})}"
      } > "$RPT/os.kv"
      html_kv "$RPT/os.kv" "Host"
      printf '</div>'
      html_pre "$OUTDIR/os/ps.txt" "Valkey / Redis processes" open
      html_pre "$OUTDIR/os/df.txt" "Filesystems"
      html_pre "$OUTDIR/os/free.txt" "free -m"
      printf '</section>\n'
    fi

    printf '</main><footer>Generated by %s %s on %s. Raw data: %s</footer>\n' "$TOOL" "$VERSION" "$(date '+%Y-%m-%d %H:%M:%S UTC')" "$(he "$OUTDIR")"
    html_js
    printf '</body></html>\n'
  } > "$HTML"
}

# ------------------------------------------------------------------- main ---
main() {
  parse_args "$@"

  if [[ -n $FROM_DIR ]]; then
    [[ -f $FROM_DIR/nodes.txt ]] || die "$FROM_DIR does not look like a $TOOL collection (nodes.txt missing)"
    OUTDIR=${FROM_DIR%/}
  else
    find_cli
    if (( ASK_PASS )); then
      read -rsp "Password: " PASSWORD < /dev/tty || die "cannot read password"
      echo >&2
    fi
    [[ -z $OUTDIR ]] && OUTDIR="./${TOOL}_${HOST//[^A-Za-z0-9._-]/_}_${PORT}_$(date +%Y%m%d_%H%M%S)"
    [[ -e $OUTDIR && -n $(ls -A "$OUTDIR" 2>/dev/null) ]] && die "output directory $OUTDIR exists and is not empty"
    umask 077
    log "$TOOL $VERSION: seed $HOST:$PORT, output $OUTDIR"
    collect_all
    if (( COLLECT_ONLY )); then
      local parent base
      parent=$(dirname "$OUTDIR"); base=$(basename "$OUTDIR")
      tar -czf "$OUTDIR.tar.gz" -C "$parent" "$base" || die "could not create $OUTDIR.tar.gz"
      log "Collection done: $OUTDIR.tar.gz"
      echo "$OUTDIR.tar.gz"
      exit 0
    fi
  fi

  [[ -z $HTML ]] && HTML="$OUTDIR/report.html"
  analyze
  (( TEXT )) && print_text
  write_html
  log "HTML report: $HTML"
  log "Raw data:    $OUTDIR"
}

main "$@"
